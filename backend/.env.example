# พอร์ตของ API (หน้าบ้านเรียกผ่าน /api)
PORT=3000

# MongoDB เช่น mongodb://localhost:27017/cm-planning หรือ MongoDB Atlas
# ถ้าไม่ตั้ง ตอนพัฒนาจะเปิด MongoDB ที่ดาวน์โหลดมาให้ เก็บข้อมูลที่ DATA_DIR/db
# MONGODB_URI=

# กุญแจลงลายเซ็น access token (production ต้องตั้ง อย่างน้อย 32 ตัวอักษร)
# AUTH_SECRET=

# ที่เก็บฐานข้อมูลตอนพัฒนาและไฟล์ที่อัปโหลด (ค่าเริ่มต้น backend/.data)
# DATA_DIR=

# แปลงไฟล์ SketchUp (.skp) เป็น 3 มิติ: โฟลเดอร์ที่มี SketchUpAPI.dll (Windows)
# ไม่ตั้ง = หา SketchUp ที่ติดตั้งใน C:\Program Files\SketchUp เอง (เปิดได้เฉพาะไฟล์ที่บันทึกจากรุ่นเดียวกันหรือเก่ากว่า)
# SKETCHUP_API_DIR=
