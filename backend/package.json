{
  "name": "cm-planning-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/api/schema.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "koffi": "^2.16.3",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "web-ifc": "^0.0.78"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "mongodb-memory-server": "^11.3.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
